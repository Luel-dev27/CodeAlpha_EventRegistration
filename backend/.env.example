# Local development. Never commit the actual .env file.
DJANGO_ENV=development
DJANGO_DEBUG=True
# Required, at least 50 random characters. Generate with Python secrets.token_urlsafe(64).
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
POSTGRES_DB=event_registration
POSTGRES_USER=event_app
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
TRUST_PROXY_SSL_HEADER=False
LOGIN_THROTTLE_RATE=10/min
SIGNUP_THROTTLE_RATE=20/hour
REGISTRATION_THROTTLE_RATE=30/min
# Optional test database name; must be different from POSTGRES_DB.
POSTGRES_TEST_DB=test_event_registration
